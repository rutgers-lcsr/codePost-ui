{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "categories": {},
  "rules": {
    "eslint/no-control-regex": "error",
    "eslint/no-unused-expressions": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/jsx-key": "warn",
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/anchor-has-content": "warn",
    "jsx-a11y/aria-props": "warn",
    "jsx-a11y/aria-role": "warn",
    "jsx-a11y/aria-unsupported-elements": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/heading-has-content": "warn",
    "jsx-a11y/img-redundant-alt": "warn",
    "jsx-a11y/label-has-associated-control": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/no-redundant-roles": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "jsx-a11y/role-supports-aria-props": "warn",
    "jsx-a11y/tabindex-no-positive": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "ignoreRestSiblings": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/components/code-review/**"],
            "message": "Use @code-review/ alias instead"
          },
          {
            "group": ["**/hooks/useExecuteFileAsync"],
            "message": "Restricted to code-review feature boundary"
          },
          {
            "group": ["**/hooks/useExecuteFileStreaming"],
            "message": "Restricted to code-review feature boundary"
          },
          {
            "group": ["**/utils/executeFileStreaming"],
            "message": "Restricted to code-review feature boundary"
          },
          {
            "group": ["**/utils/execution"],
            "message": "Restricted to code-review feature boundary"
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist",
    "build",
    "src/api-client/**",
    "src/__tests__/test_submission/node/scenarios/failure_cases/syntax_error.js",
    "src/__tests__/apiClient.test.ts"
  ]
}
